{
  "name": "@dotty/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "commands:deploy": "tsx src/discord/deploy-commands.ts",
    "maintenance:recover": "tsx scripts/recover-session.ts",
    "narrative": "tsx scripts/narrative-cli.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test": "tsx scripts/run-tests.ts",
    "typecheck": "prisma generate && tsc --noEmit"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "prisma": "^7.9.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "opusscript": "0.0.8",
    "pino": "^10.3.1",
    "prism-media": "^1.3.5",
    "zod": "^4.4.3"
  }
}

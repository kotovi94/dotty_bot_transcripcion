# Discord (create a bot application at the Discord Developer Portal)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Local services
DATABASE_URL=file:../../data/dotty.db
TRANSCRIBER_BASE_URL=http://127.0.0.1:8765
TRANSCRIBER_SHARED_SECRET=replace-with-a-long-random-local-secret
DOTTY_DATA_DIR=./data
DOTTY_LOG_LEVEL=info
DOTTY_DIAGNOSTICS_ENABLED=true

# Guion narrativo local (sin API de pago)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
DOTTY_OLLAMA_EXECUTABLE=./runtime/ollama/ollama.exe
OLLAMA_MODELS=./data/models/ollama

# Rotating recording clips (capture remains connected during rotation)
RECORDING_CLIP_TARGET_MINUTES=60
RECORDING_CLIP_SEARCH_START_MINUTES=55
RECORDING_CLIP_MAX_MINUTES=65
RECORDING_CLIP_OVERLAP_SECONDS=1.5

# Faster-Whisper defaults; tune after profiling the target GPU
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_GPU_WORKERS=1
WHISPER_LANGUAGE=es
WHISPER_INITIAL_PROMPT=Dotty es un bot de Discord que transcribe sesiones de juegos de rol.

# Procesamiento adaptativo conservador (el WAV original nunca se modifica)
ADAPTIVE_VOICE_PROCESSING=true
VOICE_VAD_ENABLED=true
VOICE_PROFILES_ENABLED=true
HALLUCINATION_DETECTION_ENABLED=true
VOICE_PREBUFFER_MIN_MS=300
VOICE_PREBUFFER_MAX_MS=600
VOICE_HANGOVER_MIN_MS=400
VOICE_HANGOVER_MAX_MS=1200
VOICE_VAD_THRESHOLD_MIN=0.30
VOICE_VAD_THRESHOLD_MAX=0.70
